# The static server of the web editor: serves the build of `npm run build:web` (base path /studio/) from /srv/studio.
# The live site (Next.js on Railway) forwards /studio/* here over Railway's private network, which is IPv6: the
# listener binds [::].
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	bind [::]

	encode zstd gzip

	# The editor needs cross-origin isolation (SharedArrayBuffer, the gyro worker's wasm threads) on every response,
	# and its own files are never embedded by another origin.
	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		Cross-Origin-Resource-Policy same-origin
		X-Content-Type-Options nosniff
	}

	handle /health {
		respond "ok" 200
	}

	redir /studio /studio/ 308

	# Hashed files (Vite's output): never change, cached for a year
	handle /studio/assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is revalidated (an ETag answers 304): index.html and sw.js must always be fresh, the
	# unhashed gyro wasm files are rarely read twice
	handle /studio/* {
		root * /srv
		header Cache-Control "no-cache"

		# The single-page fallback: a route (no file extension) answers index.html; a missing file stays a 404
		@route not path_regexp \.[A-Za-z0-9]+$
		try_files @route {path} /studio/index.html
		file_server
	}

	handle {
		respond "not found" 404
	}
}
