{
  "name": "freecut",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host",
    "dev:quiet": "vp dev --host --mode perf",
    "dev:compare": "node scripts/run-dev-and-perf.mjs",
    "shadow:contract": "node checks/shadow-contract-snapshot.mjs",
    "build": "vp build",
    "build:web": "STUDIO_BASE_PATH=/studio/ vp build --outDir dist-web",
    "check:web-base": "node checks/web-base.mjs",
    "build:perf": "vp build --mode perf",
    "lint": "vp lint src headless vite.config.ts",
    "lint:fix": "vp lint src headless vite.config.ts --fix",
    "format": "vp fmt src headless vite.config.ts package.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "vp fmt src headless vite.config.ts package.json .oxlintrc.json .oxfmtrc.json --check",
    "check:boundaries": "node scripts/check-feature-boundaries.mjs",
    "check:deps-contracts": "node scripts/check-deps-contract-boundaries.mjs",
    "check:layer-boundaries": "node scripts/check-layer-boundaries.mjs",
    "check:deps-wrapper-health": "node scripts/check-deps-wrapper-health.mjs --fail-on-unused",
    "check:unused-exports": "node scripts/check-fallow-unused-exports.mjs",
    "check:unused-class-members": "node scripts/check-fallow-unused-class-members.mjs",
    "check:changed-health": "node scripts/check-fallow-changed-health.mjs",
    "check:live-web": "node checks/live-studio-web.mjs",
    "check:feature-map": "node docs/feature-map/check.mjs && node --test docs/feature-map/check.test.mjs",
    "check:secrets": "node checks/secrets.mjs",
    "check:no-cdn": "node checks/no-cdn.mjs",
    "check:licenses": "node checks/licenses.mjs",
    "check:upstream-rows": "node checks/upstream-rows.mjs",
    "check:fork-folders": "node checks/fork-folders.mjs",
    "check:reachable": "node checks/reachable.mjs",
    "check:i18n-keys": "node checks/i18n-keys.mjs",
    "check:quick": "node checks/quick.mjs",
    "check:checks": "node --test checks/test/*.test.mjs",
    "desktop:check": "npm --prefix desktop run check",
    "desktop:test": "npm --prefix desktop test",
    "desktop:icons": "node desktop/scripts/make-icons.mjs",
    "report:deps-wrapper-health:json": "node scripts/check-deps-wrapper-health.mjs --json",
    "check:edge-budgets": "node scripts/check-feature-edge-budgets.mjs",
    "check:network": "node checks/network-origins.mjs --dist dist",
    "report:feature-edges": "node scripts/report-feature-edges.mjs",
    "report:feature-edges:json": "node scripts/report-feature-edges.mjs --json",
    "check": "vp check --no-fmt src headless vite.config.ts",
    "check:fix": "vp check src headless vite.config.ts package.json .oxlintrc.json .oxfmtrc.json --fix",
    "verify": "npm run check:quick && node checks/verify-runner.mjs --after-quick",
    "verify:serial": "npm run check:quick && vp test run && vp build && npm run check:network && npm run desktop:check && npm run desktop:test && npm run headless:test:portable",
    "package:test": "node checks/build-cache.mjs package-test",
    "preview": "vp preview",
    "preview:perf": "vp preview --host --strictPort --port 4173",
    "perf": "vp run build:perf && vp run preview:perf",
    "routes": "tsr generate",
    "test": "vp test",
    "test:run": "vp test run",
    "test:preview-sync": "vp test run src/features/preview/components/video-preview.sync.test.tsx",
    "test:preview-sync:stress": "node scripts/preview-sync-stress.mjs --runs 20",
    "test:coverage": "vp test run --coverage",
    "headless": "node headless/render.mjs",
    "headless:frame": "node headless/frame.mjs",
    "headless:oracle": "node headless/frame-oracle.mjs",
    "headless:layout": "node headless/layout.mjs",
    "headless:edit": "node headless/edit.mjs",
    "headless:serve": "node headless/serve.mjs",
    "headless:agent": "node headless/agent.mjs",
    "headless:test": "npm run build && npm run headless:test:portable",
    "headless:test:node": "node --test headless/*.test.mjs",
    "headless:test:chrome": "node headless/test.mjs --skip-build && node headless/edit-operations.mjs && node headless/lifecycle-e2e.mjs && node headless/export-media-video.mjs && node headless/subclips-e2e.mjs",
    "headless:test:media": "node headless/media-test.mjs",
    "headless:test:portable": "npm run headless:test:node && npm run headless:test:chrome && npm run headless:test:media",
    "headless:gpu:probe": "node headless/probe.mjs",
    "golden": "node golden/run.mjs",
    "golden:update": "node golden/run.mjs --update",
    "golden:test": "node --test golden/lib/kit.test.mjs",
    "bench": "node bench/run.mjs all",
    "bench:export-speed": "node bench/run.mjs export-speed-and-format",
    "bench:frame-fidelity": "node bench/run.mjs frame-fidelity",
    "bench:motion-blur": "node bench/run.mjs motion-blur",
    "bench:motion-blur-preview": "node bench/run.mjs motion-blur-preview",
    "bench:ceiling": "node bench/run.mjs ceiling",
    "bench:speed-ramp": "node bench/run.mjs speed-ramp",
    "bench:speed-ramp-audio": "node bench/run.mjs speed-ramp-audio",
    "bench:speed-ramp-stabilized": "node bench/run.mjs speed-ramp-stabilized",
    "bench:quality": "node bench/run.mjs quality",
    "bench:colour": "node bench/run.mjs colour",
    "bench:grey-ramp": "node bench/run.mjs grey-ramp",
    "bench:import": "node bench/run.mjs import",
    "bench:stage-timings": "node bench/run.mjs stage-timings",
    "bench:long-export": "node bench/run.mjs long-export",
    "bench:import-side-work": "node bench/run.mjs import-side-work",
    "bench:main-thread-export": "node bench/run.mjs main-thread-export",
    "bench:stabilized-export": "node bench/run.mjs stabilized-export",
    "bench:stabilization-controls": "node bench/run.mjs stabilization-controls",
    "bench:native-export": "node bench/run.mjs native-export",
    "bench:aac-sync": "node bench/run.mjs aac-sync",
    "bench:report": "node bench/report.mjs",
    "bench:test": "node --test bench/test/*.test.mjs",
    "bench:check": "tsc -p bench/page/tsconfig.json",
    "changelog:append": "node scripts/changelog-append.mjs",
    "changelog:rollup": "node scripts/changelog-rollup.mjs",
    "prepare": "vp config --no-hooks",
    "coverage:headless": "node scripts/headless-coverage.mjs",
    "sdk:reference": "node src/studio/sdk/reference/cli.ts"
  },
