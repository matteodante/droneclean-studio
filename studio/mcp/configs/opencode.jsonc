// OpenCode, stdio (task 2.2, design §4.1).
//
// APP is the app's wrapper: on macOS
// /Applications/DroneClean Studio.app/Contents/Resources/mcp/droneclean-mcp
// (Windows: ...\DroneClean Studio\resources\mcp\droneclean-mcp.cmd).
// Agent access is on by default; Settings → Agent access switches it off.
{
  "mcp": {
    "servers": {
      "droneclean": {
        "type": "local",
        "command": ["APP"]
      }
    }
  }
}
